# ── Clerk ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Si esta app es la principal (no satélite), Clerk usa las vars anteriores.
# Si usás satellite auth con app-pedidos, agregá estas:
# NEXT_PUBLIC_CLERK_IS_SATELLITE=false
# NEXT_PUBLIC_CLERK_DOMAIN=tudominio.clerk.accounts.dev

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Comunicación entre servicios ────────────────────────────────────────────
# API key que esta app acepta en el header x-api-key de requests entrantes
TIENDA_API_KEY=clave-secreta-tienda

# URL y API key de app-pedidos (para leer/actualizar pedidos desde el admin)
PEDIDOS_API_URL=http://localhost:3005
PEDIDOS_API_KEY=clave-secreta-pedidos
